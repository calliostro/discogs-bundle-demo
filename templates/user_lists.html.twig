{% extends 'base.html.twig' %}

{% block title %}My Lists{% endblock %}

{% block body %}
<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('default_index') }}">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Lists</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">📋 My Lists</h1>
        <span class="badge bg-primary fs-6">{{ username }}</span>
    </div>

    {% if lists is defined and lists.lists|length > 0 %}
        <div class="row">
            {% for list in lists.lists %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <i class="bi bi-list-ul text-primary"></i> {{ list.name }}
                            </h5>
                            
                            {% if list.description is defined and list.description %}
                                <p class="card-text text-muted">{{ list.description|slice(0, 100) }}{% if list.description|length > 100 %}...{% endif %}</p>
                            {% endif %}
                            
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        {% if list.public is defined %}
                                            <span class="badge bg-{{ list.public ? 'success' : 'secondary' }}">
                                                <i class="bi bi-{{ list.public ? 'eye' : 'eye-slash' }}"></i>
                                                {{ list.public ? 'Public' : 'Private' }}
                                            </span>
                                        {% endif %}
                                        
                                        {% if list.items is defined %}
                                            <span class="badge bg-info">
                                                📄 {{ list.items }} item{{ list.items != 1 ? 's' : '' }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                                
                                {% if list.date_added is defined %}
                                    <small class="text-muted d-block mt-2">
                                        📅 Created: {{ list.date_added|date('Y-m-d') }}
                                    </small>
                                {% endif %}
                                
                                {% if list.date_changed is defined %}
                                    <small class="text-muted d-block">
                                        🔄 Modified: {{ list.date_changed|date('Y-m-d') }}
                                    </small>
                                {% endif %}
                                
                                <div class="mt-3">
                                    <a href="{{ path('list_detail', {'id': list.id}) }}" class="btn btn-primary btn-sm">
                                        <i class="bi bi-eye"></i> View List
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if lists.pagination is defined and lists.pagination.pages > 1 %}
            <nav aria-label="User lists pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    {% if lists.pagination.page > 1 %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('user_lists', {'page': lists.pagination.page - 1}) }}">Previous</a>
                        </li>
                    {% endif %}
                    
                    {% for page in 1..lists.pagination.pages %}
                        {% if page == lists.pagination.page %}
                            <li class="page-item active"><span class="page-link">{{ page }}</span></li>
                        {% else %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('user_lists', {'page': page}) }}">{{ page }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}
                    
                    {% if lists.pagination.page < lists.pagination.pages %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('user_lists', {'page': lists.pagination.page + 1}) }}">Next</a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    {% else %}
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i>
            <strong>No lists found.</strong> You haven't created any lists yet.
        </div>
    {% endif %}
</div>
{% endblock %}
