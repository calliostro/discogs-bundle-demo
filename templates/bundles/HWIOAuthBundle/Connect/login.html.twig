{% extends 'base.html.twig' %}

{% block title %}Login - Discogs Bundle Demo (v3.x){% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <h2 class="card-title fw-bold mb-3">🎵 Discogs OAuth Login</h2>
                <p class="text-muted mb-4">
                    Sign in with your Discogs account to explore the authenticated endpoints of this demo (Collections, Wantlists, Profile, Marketplace).
                </p>

                {% if error is defined and error %}
                    <div class="alert alert-danger text-start mb-3" role="alert">
                        <strong>Authentication Error:</strong> {{ error }}
                    </div>
                {% endif %}

                <div class="d-grid gap-2 mb-4">
                    {% for owner in hwi_oauth_resource_owners() %}
                        <a href="{{ hwi_oauth_login_url(owner) }}" class="btn btn-primary btn-lg shadow-sm">
                            <i class="bi bi-disc"></i> Connect with {{ owner|capitalize }}
                        </a>
                    {% endfor %}
                </div>

                <div class="alert alert-warning text-start small mb-0" role="alert">
                    <h6 class="alert-heading fw-bold mb-2">⚠️ Configuration Required</h6>
                    <p class="mb-2">
                        The OAuth 1.0a handshake requires valid Discogs API developer credentials.
                        <strong>If clicking the button fails or simply reloads this page</strong>, your credentials are either missing or have been rejected by Discogs:
                    </p>
                    <ol class="mb-2 ps-3">
                        <li class="mb-2">
                            Register an application at <a href="https://www.discogs.com/applications/edit" target="_blank" class="alert-link">discogs.com/applications/edit</a>:
                            <ul class="text-muted mt-1 ps-3">
                                <li><strong>Application Name:</strong> e.g. <code>Discogs Bundle Demo</code></li>
                                <li><strong>Description:</strong> e.g. <code>Demo for testing calliostro/discogs-bundle</code></li>
                                <li><strong>Homepage URL:</strong> <code>{{ app.request.schemeAndHttpHost }}</code></li>
                                <li><strong>Callback URL:</strong> <code>{{ app.request.schemeAndHttpHost }}/login/check-discogs</code></li>
                            </ul>
                        </li>
                        <li>Add your <code>CONSUMER_KEY</code> and <code>CONSUMER_SECRET</code> to <code>.env</code> (or <code>.env.local</code>).</li>
                    </ol>
                    <p class="mb-0 text-muted">
                        <em>Tip: In <code>calliostro/discogs-bundle</code> v4+, OAuth authentication is natively built into the bundle.</em>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
