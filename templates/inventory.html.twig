{% extends 'base.html.twig' %}

{% block title %}My Inventory{% endblock %}

{% block body %}
<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('default_index') }}">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Inventory</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">📦 My Inventory</h1>
        <span class="badge bg-primary fs-6">{{ username }}</span>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <form method="get" action="{{ path('user_inventory') }}" class="d-flex">
                <select name="status" class="form-select me-2">
                    <option value="For Sale" {{ status == 'For Sale' ? 'selected' : '' }}>For Sale</option>
                    <option value="Draft" {{ status == 'Draft' ? 'selected' : '' }}>Draft</option>
                    <option value="Expired" {{ status == 'Expired' ? 'selected' : '' }}>Expired</option>
                    <option value="Sold" {{ status == 'Sold' ? 'selected' : '' }}>Sold</option>
                </select>
                <button type="submit" class="btn btn-primary">Filter</button>
            </form>
        </div>
    </div>

    {% if inventory is defined and inventory.listings|length > 0 %}
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i>
            Showing {{ inventory.listings|length }} listings with status "<strong>{{ status }}</strong>"
        </div>

        <div class="row">
            {% for listing in inventory.listings %}
                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        {% if listing.release is defined and listing.release.basic_information is defined and listing.release.basic_information.thumb %}
                            <img src="{{ listing.release.basic_information.thumb }}" class="card-img-top" alt="{{ listing.release.basic_information.title }}" style="height: 200px; object-fit: cover;">
                        {% else %}
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-disc fs-1 text-muted"></i>
                            </div>
                        {% endif %}
                        
                        <div class="card-body d-flex flex-column">
                            {% if listing.release is defined and listing.release.basic_information is defined %}
                                <h6 class="card-title">{{ listing.release.basic_information.title }}</h6>
                                
                                {% if listing.release.basic_information.artists is defined and listing.release.basic_information.artists|length > 0 %}
                                    <p class="card-text text-muted">
                                        {% for artist in listing.release.basic_information.artists %}
                                            <a href="{{ path('artist_detail', {'id': artist.id}) }}" class="text-decoration-none">
                                                {{ artist.name }}
                                            </a>{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    </p>
                                {% endif %}
                            {% endif %}
                            
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                {% if listing.condition is defined %}
                                    <span class="badge bg-secondary">🔍 {{ listing.condition }}</span>
                                {% endif %}
                                
                                {% if listing.status is defined %}
                                    <span class="badge bg-{{ listing.status == 'For Sale' ? 'success' : (listing.status == 'Sold' ? 'danger' : 'warning') }}">
                                        📋 {{ listing.status }}
                                    </span>
                                {% endif %}
                            </div>
                            
                            {% if listing.price is defined %}
                                <div class="card-text">
                                    <strong class="text-success fs-5">
                                        💰 {{ listing.price.currency }}{{ listing.price.value }}
                                    </strong>
                                </div>
                            {% endif %}
                            
                            {% if listing.posted is defined %}
                                <small class="text-muted">
                                    📅 Posted: {{ listing.posted|date('Y-m-d H:i') }}
                                </small>
                            {% endif %}
                            
                            {% if listing.ships_from is defined %}
                                <small class="text-muted">
                                    🚚 Ships from: {{ listing.ships_from }}
                                </small>
                            {% endif %}
                            
                            <div class="mt-auto pt-2">
                                {% if listing.release is defined and listing.release.basic_information is defined and listing.release.basic_information.id %}
                                    <a href="{{ path('release_detail', {'id': listing.release.basic_information.id}) }}" class="btn btn-primary btn-sm">
                                        <i class="bi bi-eye"></i> View Release
                                    </a>
                                {% endif %}
                                
                                {% if listing.uri is defined %}
                                    <a href="https://www.discogs.com{{ listing.uri }}" target="_blank" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-box-arrow-up-right"></i> View on Discogs
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if inventory.pagination is defined and inventory.pagination.pages > 1 %}
            <nav aria-label="Inventory pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    {% if inventory.pagination.page > 1 %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('user_inventory', {'status': status, 'page': inventory.pagination.page - 1}) }}">Previous</a>
                        </li>
                    {% endif %}
                    
                    {% for page in 1..inventory.pagination.pages %}
                        {% if page == inventory.pagination.page %}
                            <li class="page-item active"><span class="page-link">{{ page }}</span></li>
                        {% else %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('user_inventory', {'status': status, 'page': page}) }}">{{ page }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}
                    
                    {% if inventory.pagination.page < inventory.pagination.pages %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('user_inventory', {'status': status, 'page': inventory.pagination.page + 1}) }}">Next</a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    {% else %}
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i>
            <strong>No inventory found.</strong> You don't have any listings with status "{{ status }}".
        </div>
        
        <div class="text-center py-3">
            <p class="text-muted">Try changing the status filter or visit your Discogs seller account to manage your inventory.</p>
            <a href="https://www.discogs.com/sell" target="_blank" class="btn btn-primary">
                <i class="bi bi-box-arrow-up-right"></i> Manage Inventory on Discogs
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
