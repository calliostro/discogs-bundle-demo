<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>

        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
            <style>
                .card-img-top {
                    transition: transform 0.2s;
                }
                .card:hover .card-img-top {
                    transform: scale(1.05);
                }
                .breadcrumb {
                    background-color: #f8f9fa;
                    padding: 10px 15px;
                    border-radius: 5px;
                    margin-bottom: 20px;
                }
            </style>
        {% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('default_index') }}">
                    🎵 Discogs Bundle Demo
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('default_index') }}">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('search') }}">Search</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('user_collection') }}">Collection</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('user_wantlist') }}">Wantlist</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('user_profile') }}">Profile</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('random_releases') }}">Random Releases</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="container-fluid mt-4">
            {% for flash_error in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ flash_error }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% for flash_notice in app.flashes('notice') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ flash_notice }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="bg-dark text-light text-center py-4 mt-5">
            <div class="container">
                <p class="mb-0">
                    Powered by <a href="https://github.com/calliostro/discogs-bundle" target="_blank" class="text-light">calliostro/discogs-bundle</a>
                    & <a href="https://github.com/calliostro/php-discogs-api" target="_blank" class="text-light">calliostro/php-discogs-api</a>
                </p>
            </div>
        </footer>

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        {% endblock %}
    </body>
</html>
