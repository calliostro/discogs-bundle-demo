{% extends 'base.html.twig' %}

{% block title %}List Details{% endblock %}

{% block body %}
<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('default_index') }}">Home</a></li>
            <li class="breadcrumb-item"><a href="{{ path('user_lists') }}">My Lists</a></li>
            <li class="breadcrumb-item active" aria-current="page">List #{{ listId }}</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">📝 List Details</h1>
        <span class="badge bg-primary fs-6">List ID: {{ listId }}</span>
    </div>

    {% if listItems is defined and listItems.items|length > 0 %}
        <div class="row">
            {% for item in listItems.items %}
                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        {% if item.basic_information is defined and item.basic_information.thumb %}
                            <img src="{{ item.basic_information.thumb }}" class="card-img-top" alt="{{ item.basic_information.title }}" style="height: 200px; object-fit: cover;">
                        {% else %}
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-disc fs-1 text-muted"></i>
                            </div>
                        {% endif %}
                        
                        <div class="card-body d-flex flex-column">
                            {% if item.basic_information is defined %}
                                <h6 class="card-title">{{ item.basic_information.title }}</h6>
                                
                                {% if item.basic_information.artists is defined and item.basic_information.artists|length > 0 %}
                                    <p class="card-text text-muted">
                                        {% for artist in item.basic_information.artists %}
                                            <a href="{{ path('artist_detail', {'id': artist.id}) }}" class="text-decoration-none">
                                                {{ artist.name }}
                                            </a>{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    </p>
                                {% endif %}
                                
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    {% if item.basic_information.year is defined and item.basic_information.year %}
                                        <span class="badge bg-primary">📅 {{ item.basic_information.year }}</span>
                                    {% endif %}
                                    
                                    {% if item.basic_information.formats is defined and item.basic_information.formats|length > 0 %}
                                        {% for format in item.basic_information.formats %}
                                            <span class="badge bg-secondary">{{ format.name }}</span>
                                        {% endfor %}
                                    {% endif %}
                                </div>
                                
                                {% if item.basic_information.labels is defined and item.basic_information.labels|length > 0 %}
                                    <p class="card-text text-muted small">
                                        🏷️ 
                                        {% for label in item.basic_information.labels %}
                                            <a href="{{ path('label_detail', {'id': label.id}) }}" class="text-decoration-none">
                                                {{ label.name }}
                                            </a>{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    </p>
                                {% endif %}
                            {% endif %}
                            
                            {% if item.date_added is defined %}
                                <small class="text-muted">
                                    📅 Added to list: {{ item.date_added|date('Y-m-d H:i') }}
                                </small>
                            {% endif %}
                            
                            <div class="mt-auto pt-2">
                                {% if item.basic_information is defined and item.basic_information.id %}
                                    <a href="{{ path('release_detail', {'id': item.basic_information.id}) }}" class="btn btn-primary btn-sm">
                                        <i class="bi bi-eye"></i> View Release
                                    </a>
                                {% endif %}
                                
                                {% if item.basic_information is defined and item.basic_information.master_id %}
                                    <a href="{{ path('master_detail', {'id': item.basic_information.master_id}) }}" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-disc"></i> Master
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if listItems.pagination is defined and listItems.pagination.pages > 1 %}
            <nav aria-label="List items pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    {% if listItems.pagination.page > 1 %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('list_detail', {'id': listId, 'page': listItems.pagination.page - 1}) }}">Previous</a>
                        </li>
                    {% endif %}
                    
                    {% for page in 1..listItems.pagination.pages %}
                        {% if page == listItems.pagination.page %}
                            <li class="page-item active"><span class="page-link">{{ page }}</span></li>
                        {% else %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('list_detail', {'id': listId, 'page': page}) }}">{{ page }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}
                    
                    {% if listItems.pagination.page < listItems.pagination.pages %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('list_detail', {'id': listId, 'page': listItems.pagination.page + 1}) }}">Next</a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    {% else %}
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i>
            <strong>No items found.</strong> This list is empty or doesn't exist.
        </div>
        
        <a href="{{ path('user_lists') }}" class="btn btn-primary">
            <i class="bi bi-arrow-left"></i> Back to My Lists
        </a>
    {% endif %}
</div>
{% endblock %}
