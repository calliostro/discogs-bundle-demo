{% extends 'base.html.twig' %}

{% block title %}calliostro/discogs-bundle-demo{% endblock %}

{% block body %}
    <h1>calliostro/discogs-bundle-demo</h1>
    <p>This page shows who you're authenticated as, and it also doubles as a good sanity check to ensure that you're using OAuth correctly.</p>

    <div class="row">
        <div class="col-md-6">
            <h3>User Information</h3>
            <table class="table table-striped">
                <tbody>
                <tr><td>Username:</td><td>{{ identity.username }}</td></tr>
                <tr><td>Resource URL:</td><td><a href="{{ identity.resource_url }}" target="_blank">{{ identity.resource_url }}</a></td></tr>
                <tr><td>Consumer Name:</td><td>{{ identity.consumer_name }}</td></tr>
                </tbody>
            </table>
        </div>

        <div class="col-md-6">
            <h3>Discogs API Demo Features</h3>
            <div class="list-group">
                <a href="{{ path('search') }}" class="list-group-item list-group-item-action">
                    <h5 class="mb-1">🔍 Search</h5>
                    <p class="mb-1">Search the Discogs database for artists, releases, labels and more</p>
                </a>

                <a href="{{ path('user_collection') }}" class="list-group-item list-group-item-action">
                    <h5 class="mb-1">📀 My Collection</h5>
                    <p class="mb-1">View your Discogs collection</p>
                </a>

                <a href="{{ path('user_wantlist') }}" class="list-group-item list-group-item-action">
                    <h5 class="mb-1">💝 My Wantlist</h5>
                    <p class="mb-1">View your Discogs wantlist</p>
                </a>

                <a href="{{ path('user_profile') }}" class="list-group-item list-group-item-action">
                    <h5 class="mb-1">👤 My Profile</h5>
                    <p class="mb-1">View your complete Discogs profile</p>
                </a>

                <a href="{{ path('random_releases') }}" class="list-group-item list-group-item-action">
                    <h5 class="mb-1">🎲 Random Releases</h5>
                    <p class="mb-1">Discover random releases from popular artists</p>
                </a>
            </div>

            <h4 class="mt-4">Direct Links to Example Data:</h4>
            <ul class="list-unstyled">
                <li><a href="{{ path('artist_detail', {'id': 8760}) }}">Pink Floyd (Artist #8760)</a></li>
                <li><a href="{{ path('release_detail', {'id': 1}) }}">Release #1</a></li>
                <li><a href="{{ path('artist_detail', {'id': 82730}) }}">The Beatles (Artist #82730)</a></li>
            </ul>
        </div>
    </div>
{% endblock body %}
