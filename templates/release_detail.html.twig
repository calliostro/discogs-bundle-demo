{% extends 'base.html.twig' %}

{% block title %}{{ release.title }} - Discogs Bundle Demo{% endblock %}

{% block body %}
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('default_index') }}">Home</a></li>
                <li class="breadcrumb-item active">{{ release.title }}</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-md-4">
                {% if release.images is defined and release.images|length > 0 %}
                    <img src="{{ release.images[0].uri }}" alt="{{ release.title }}" class="img-fluid rounded mb-3">
                {% endif %}

                <h1>{{ release.title }}</h1>

                <table class="table table-sm">
                    <tbody>
                        {% if release.artists is defined %}
                            <tr>
                                <td><strong>Artist(s):</strong></td>
                                <td>
                                    {% for artist in release.artists %}
                                        <a href="{{ path('artist_detail', {'id': artist.id}) }}">{{ artist.name }}</a>
                                        {% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </td>
                            </tr>
                        {% endif %}

                        {% if release.year is defined %}
                            <tr>
                                <td><strong>Year:</strong></td>
                                <td>{{ release.year }}</td>
                            </tr>
                        {% endif %}

                        {% if release.labels is defined %}
                            <tr>
                                <td><strong>Label(s):</strong></td>
                                <td>
                                    {% for label in release.labels %}
                                        {{ label.name }}
                                        {% if label.catno is defined %} ({{ label.catno }}){% endif %}
                                        {% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </td>
                            </tr>
                        {% endif %}

                        {% if release.formats is defined %}
                            <tr>
                                <td><strong>Format(s):</strong></td>
                                <td>
                                    {% for format in release.formats %}
                                        {{ format.name }}
                                        {% if format.qty is defined %} ({{ format.qty }}x){% endif %}
                                        {% if format.descriptions is defined %} - {{ format.descriptions|join(', ') }}{% endif %}
                                        {% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </td>
                            </tr>
                        {% endif %}

                        {% if release.genres is defined %}
                            <tr>
                                <td><strong>Genre(s):</strong></td>
                                <td>{{ release.genres|join(', ') }}</td>
                            </tr>
                        {% endif %}

                        {% if release.styles is defined %}
                            <tr>
                                <td><strong>Style(s):</strong></td>
                                <td>{{ release.styles|join(', ') }}</td>
                            </tr>
                        {% endif %}

                        {% if release.country is defined %}
                            <tr>
                                <td><strong>Country:</strong></td>
                                <td>{{ release.country }}</td>
                            </tr>
                        {% endif %}

                        {% if release.released is defined %}
                            <tr>
                                <td><strong>Released:</strong></td>
                                <td>{{ release.released }}</td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>

                {% if release.notes is defined %}
                    <div class="mt-3">
                        <h5>Notes:</h5>
                        <p>{{ release.notes|nl2br }}</p>
                    </div>
                {% endif %}
            </div>

            <div class="col-md-8">
                {% if release.tracklist is defined and release.tracklist|length > 0 %}
                    <h4>Tracklist:</h4>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Position</th>
                                    <th>Title</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for track in release.tracklist %}
                                <tr>
                                    <td>{{ track.position ?? '' }}</td>
                                    <td>
                                        {{ track.title }}
                                        {% if track.artists is defined %}
                                            <br><small class="text-muted">
                                                {% for artist in track.artists %}
                                                    {{ artist.name }}{% if not loop.last %}, {% endif %}
                                                {% endfor %}
                                            </small>
                                        {% endif %}
                                    </td>
                                    <td>{{ track.duration ?? '' }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                {% if release.extraartists is defined and release.extraartists|length > 0 %}
                    <div class="mt-4">
                        <h4>Credits:</h4>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Role</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for artist in release.extraartists %}
                                    <tr>
                                        <td>
                                            <a href="{{ path('artist_detail', {'id': artist.id}) }}">{{ artist.name }}</a>
                                        </td>
                                        <td>{{ artist.role }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}

                {% if release.identifiers is defined and release.identifiers|length > 0 %}
                    <div class="mt-4">
                        <h4>Identifiers:</h4>
                        <ul class="list-unstyled">
                        {% for identifier in release.identifiers %}
                            <li><strong>{{ identifier.type }}:</strong> {{ identifier.value }}</li>
                        {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock body %}
